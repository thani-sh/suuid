{
  "name": "@thani-sh/suuid",
  "version": "1.0.1",
  "description": "Shorter base62 encoded UUIDs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "bun test"
  },
  "keywords": [
    "uuid",
    "suuid",
    "short-uuid",
    "identifier",
    "base62"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "@types/bun": "latest",
    "prettier": "^3.8.4"
  },
  "repository": {
    "type": "git",
    "url": "git@github.thani.sh:thani-sh/suuid.git"
  },
  "private": true
}
